# ==============================================================================
# VedaAI Production Environment Configuration (.env.example)
# ==============================================================================

# --- Global / Environment ---
ENVIRONMENT=production
NODE_ENV=production

# --- Frontend (Next.js) ---
# Set this to the public URL of your deployed Railway FastAPI API (e.g. https://vedaai-api.up.railway.app)
NEXT_PUBLIC_API_URL=https://vedaai-api.up.railway.app
PORT=3000

# --- Backend (FastAPI) ---
PORT=8000
HOST=0.0.0.0
# Comma-separated list of allowed frontend origins, or * for public access
CORS_ORIGINS=https://vedaai-web.up.railway.app,http://localhost:3000,http://localhost:3100

# --- Google Gemini AI ---
# Pass your production Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# --- PostgreSQL Database ---
# For Railway, use the provided DATABASE_URL variable from the PostgreSQL plugin
DATABASE_URL=postgresql://postgres:postgres@vedaai-db:5432/vedaai
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=vedaai
POSTGRES_HOST=vedaai-db
POSTGRES_PORT=5432

# --- Local Docker Compose Port Bindings (Do NOT use 3000, 8000, 5432) ---
WEB_PORT=3100
API_PORT=8100
DB_PORT=5445
