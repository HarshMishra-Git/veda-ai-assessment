# ==============================================================================
# FastAPI API Production Environment Configuration
# ==============================================================================

PROJECT_NAME=VedaAI API
VERSION=0.1.0
ENVIRONMENT=production
PORT=8000
HOST=0.0.0.0

# CORS Allowed Origins (Comma-separated list or * for wildcard)
CORS_ORIGINS=https://vedaai-web.up.railway.app,http://localhost:3000,http://localhost:3100

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# PostgreSQL Database (Railway provides DATABASE_URL automatically)
DATABASE_URL=postgresql://postgres:postgres@vedaai-db:5432/vedaai
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=vedaai
POSTGRES_HOST=vedaai-db
POSTGRES_PORT=5432
