{
  "name": "vedaai-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=web",
    "build:web": "npm run build --workspace=web",
    "start:web": "npm run start --workspace=web",
    "lint:web": "npm run lint --workspace=web",
    "dev:api": "cd apps/api && source .venv/bin/activate && uvicorn app.main:app --reload --port 8000",
    "setup:api": "cd apps/api && python3 -m venv .venv && source .venv/bin/activate && pip install -r requirements.txt",
    "test:health": "curl -s http://localhost:8000/api/health"
  }
}
